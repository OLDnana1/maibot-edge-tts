{
  "manifest_version": 2,
  "version": "1.0.0",
  "name": "Edge TTS 免费语音",
  "description": "使用微软 Edge 在线语音合成（edge-tts）把文字转成 QQ 语音，支持音色、语速、音量、音调与代理配置",
  "author": {
    "name": "OLDnana1",
    "url": "https://github.com/OLDnana1"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/OLDnana1/maibot-edge-tts",
    "homepage": "https://github.com/OLDnana1/maibot-edge-tts",
    "documentation": "https://github.com/OLDnana1/maibot-edge-tts/blob/main/README.md",
    "issues": "https://github.com/OLDnana1/maibot-edge-tts/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "edge-tts",
      "version_spec": ">=7.0.0"
    }
  ],
  "capabilities": [
    "send.custom",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "github.OLDnana1.edge-tts"
}
